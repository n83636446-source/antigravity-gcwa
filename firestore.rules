rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Core Philosophy: This ruleset establishes a baseline security model for an
     * internal inventory management tool. The primary goal during this prototyping
     * phase is to ensure that only authenticated users can interact with the
     * data, preventing any public or anonymous access. It assumes all signed-in
     * users are trusted operators with full permissions.
     *
     * Data Structure: The data is organized with top-level collections for major
     * entities like suppliers, products, and clients to allow for flexible relationships.
     * - /suppliers/{supplierId}
     * - /products/{productId}
     *   - /stockAlerts/{stockAlertId}
     * - /reports/{reportId}
     *
     * Key Security Decisions:
     * - Authenticated Access Only: All read and write operations across all
     *   collections require the user to be signed in. This provides a fundamental
     *   layer of security.
     * - No User-Specific Ownership (Prototype Limitation): The current data models
     *   do not contain a reference to a user (e.g., an `ownerId`). Therefore, the
     *   rules grant access to ANY authenticated user. For production,
     *   denormalizing user IDs onto documents is critical.
     * - Flexible Schema: In line with the prototyping philosophy, these rules do
     *   not enforce the shape or data types of documents, aside from basic
     *   relational integrity where necessary.
     */

    // --------------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if a document exists. Used to protect update/delete operations
     * from acting on non-existent data.
     */
    function resourceExists() {
      return resource != null;
    }

    // --------------------------------------------------------------------------
    // Collection Rules
    // --------------------------------------------------------------------------

    /**
     * @description Manages access to supplier documents. Any authenticated user
     * can manage supplier information.
     */
    match /suppliers/{supplierId} {
      allow read, write: if isSignedIn();
    }
    
    /**
     * @description Manages product documents, which are now a top-level collection.
     * Any authenticated user can manage products.
     */
    match /products/{productId} {
      allow read, write: if isSignedIn();
    }


    /**
     * @description Allows listing products across all suppliers for authenticated users.
     */
    match /{path=**}/products/{productId} {
      allow list: if isSignedIn();
    }

    /**
     * @description Manages stock alerts, nested under a specific product. Any
     * authenticated user can manage stock alerts.
     * @principle Enforces relational integrity by ensuring an alert's internal
     * `productId` field is immutable and matches its parent document in the path.
     */
    match /products/{productId}/stockAlerts/{stockAlertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.productId == productId;
      allow update: if isSignedIn() && resourceExists() && request.resource.data.productId == resource.data.productId;
      allow delete: if isSignedIn() && resourceExists();
    }

    /**
     * @description Manages top-level report documents. Access is restricted to
     * authenticated users for all operations.
     */
    match /reports/{reportId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Manages client documents. Any authenticated user can manage clients.
     */
    match /clients/{clientId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Manages purchase order documents. Any authenticated user can manage them.
     */
    match /purchaseOrders/{purchaseOrderId} {
        allow read, write: if isSignedIn();
    }
    
    /**
     * @description Manages purchase receipt documents. Any authenticated user can manage them.
     */
    match /purchaseReceipts/{purchaseReceiptId} {
        allow read, write: if isSignedIn();
    }

    /**
     * @description Manages purchase invoice documents. Any authenticated user can manage them.
     */
    match /purchaseInvoices/{purchaseInvoiceId} {
        allow read, write: if isSignedIn();
    }

    /**
     * @description Manages credit note documents. Any authenticated user can manage them.
     */
    match /creditNotes/{creditNoteId} {
        allow read, write: if isSignedIn();
    }

    /**
     * @description Manages article family documents. Any authenticated user can manage them.
     */
    match /articleFamilies/{familyId} {
        allow get, write: if isSignedIn();
        allow list: if isSignedIn();
    }
  }
}
