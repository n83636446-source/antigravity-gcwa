{
  "entities": {
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Article",
      "type": "object",
      "description": "Represents an article in the inventory.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the article."
        },
        "code": {
          "type": "string",
          "description": "Unique code for the article, e.g., ART001."
        },
        "name": {
          "type": "string",
          "description": "Name of the article."
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the article."
        },
        "price": {
          "type": "number",
          "description": "Selling price of the article."
        },
        "stockLevel": {
          "type": "number",
          "description": "Current stock level of the article."
        },
        "reorderThreshold": {
          "type": "number",
          "description": "Threshold at which a reorder alert is triggered."
        }
      },
      "required": [
        "id",
        "code",
        "name",
        "description",
        "price",
        "stockLevel",
        "reorderThreshold"
      ]
    },
    "Supplier": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Supplier",
      "type": "object",
      "description": "Represents a supplier of products.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the supplier."
        },
        "code": {
          "type": "string",
          "description": "Unique code for the supplier."
        },
        "name": {
          "type": "string",
          "description": "Name of the supplier."
        },
        "contactName": {
          "type": "string",
          "description": "Contact name for the supplier."
        },
        "contactEmail": {
          "type": "string",
          "description": "Contact email for the supplier.",
          "format": "email"
        },
        "contactPhone": {
          "type": "string",
          "description": "Contact phone number for the supplier."
        },
        "street": {
          "type": "string",
          "description": "Street address of the supplier."
        },
        "city": {
          "type": "string",
          "description": "City of the supplier."
        },
        "country": {
          "type": "string",
          "description": "Country of the supplier."
        },
        "ice": {
          "type": "string",
          "description": "ICE number of the supplier."
        }
      },
      "required": [
        "id",
        "code",
        "name",
        "contactName",
        "contactEmail",
        "contactPhone",
        "street",
        "city",
        "country",
        "ice"
      ]
    },
    "StockAlert": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StockAlert",
      "type": "object",
      "description": "Represents a stock alert notification.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the stock alert."
        },
        "productId": {
          "type": "string",
          "description": "Reference to Product. (Relationship: Product 1:N StockAlert)"
        },
        "alertDate": {
          "type": "string",
          "description": "Date and time when the alert was triggered.",
          "format": "date-time"
        },
        "currentStockLevel": {
          "type": "number",
          "description": "Stock level at the time the alert was triggered."
        },
        "reorderThreshold": {
          "type": "number",
          "description": "Reorder threshold that triggered the alert."
        },
        "expectedNeedEstimate": {
          "type": "number",
          "description": "AI estimated quantity needed for reorder."
        }
      },
      "required": [
        "id",
        "productId",
        "alertDate",
        "currentStockLevel",
        "reorderThreshold"
      ]
    },
    "Report": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Report",
      "type": "object",
      "description": "Represents a report on stock levels, sales trends, and inventory turnover rates.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the report."
        },
        "reportType": {
          "type": "string",
          "description": "Type of the report (e.g., Stock Level, Sales Trend, Inventory Turnover)."
        },
        "generatedDate": {
          "type": "string",
          "description": "Date and time when the report was generated.",
          "format": "date-time"
        },
        "data": {
          "type": "string",
          "description": "The stringified JSON data of the report."
        }
      },
      "required": [
        "id",
        "reportType",
        "generatedDate",
        "data"
      ]
    },
    "Client": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Client",
      "type": "object",
      "description": "Represents a client or customer.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the client."
        },
        "name": {
          "type": "string",
          "description": "Name of the client."
        },
        "email": {
          "type": "string",
          "description": "Contact email for the client.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number for the client."
        },
        "address": {
          "type": "string",
          "description": "Address of the client."
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "phone"
      ]
    },
    "PurchaseOrder": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PurchaseOrder",
      "type": "object",
      "description": "Represents a purchase order sent to a supplier.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the purchase order."
        },
        "orderNumber": {
          "type": "string",
          "description": "The unique number for the purchase order."
        },
        "supplierId": {
          "type": "string",
          "description": "Reference to the Supplier."
        },
        "orderDate": {
          "type": "string",
          "format": "date-time",
          "description": "Date the order was placed."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total amount of the order."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "price": {
                "type": "number"
              }
            },
            "required": [
              "productId",
              "quantity",
              "price"
            ]
          }
        }
      },
      "required": [
        "orderNumber",
        "supplierId",
        "orderDate",
        "totalAmount",
        "items"
      ]
    },
    "PurchaseReceipt": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PurchaseReceipt",
      "type": "object",
      "description": "Represents a receipt of goods from a supplier.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the purchase receipt."
        },
        "receiptNumber": {
          "type": "string",
          "description": "The unique number for the purchase receipt."
        },
        "purchaseOrderId": {
          "type": "string",
          "description": "Optional reference to the PurchaseOrder."
        },
        "supplierId": {
          "type": "string",
          "description": "Reference to the Supplier."
        },
        "receiptDate": {
          "type": "string",
          "format": "date-time",
          "description": "Date the goods were received."
        },
        "notes": {
          "type": "string",
          "description": "Notes about the receipt."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string"
              },
              "quantityReceived": {
                "type": "number"
              }
            },
            "required": [
              "productId",
              "quantityReceived"
            ]
          }
        },
        "status": {
          "type": "string",
          "description": "The status of the purchase receipt.",
          "enum": [
            "Brouillon",
            "Validé"
          ]
        }
      },
      "required": [
        "receiptNumber",
        "supplierId",
        "receiptDate",
        "items",
        "status"
      ]
    },
    "PurchaseInvoice": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PurchaseInvoice",
      "type": "object",
      "description": "Represents a purchase invoice from a supplier.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the purchase invoice."
        },
        "invoiceNumber": {
          "type": "string",
          "description": "The unique number for the purchase invoice."
        },
        "purchaseOrderId": {
          "type": "string",
          "description": "Optional reference to the PurchaseOrder."
        },
        "supplierId": {
          "type": "string",
          "description": "Reference to the Supplier."
        },
        "invoiceDate": {
          "type": "string",
          "format": "date-time",
          "description": "Date the invoice was issued."
        },
        "dueDate": {
          "type": "string",
          "format": "date-time",
          "description": "Date the invoice is due."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total amount of the invoice."
        },
        "status": {
          "type": "string",
          "enum": [
            "Brouillon",
            "Non payée",
            "Payée",
            "En retard"
          ],
          "description": "Status of the invoice."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "price": {
                "type": "number"
              }
            },
            "required": [
              "productId",
              "quantity",
              "price"
            ]
          }
        }
      },
      "required": [
        "invoiceNumber",
        "supplierId",
        "invoiceDate",
        "dueDate",
        "totalAmount",
        "status",
        "items"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/suppliers/{supplierId}",
        "definition": {
          "entityName": "Supplier",
          "schema": {
            "$ref": "#/backend/entities/Supplier"
          },
          "description": "Stores supplier information.  `supplierId` is the unique identifier for the supplier.",
          "params": [
            {
              "name": "supplierId",
              "description": "Unique identifier for the supplier."
            }
          ]
        }
      },
      {
        "path": "/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": {
            "$ref": "#/backend/entities/Product"
          },
          "description": "Stores article information. `productId` is the unique identifier for the article.",
          "params": [
            {
              "name": "productId",
              "description": "Unique identifier for the article."
            }
          ]
        }
      },
      {
        "path": "/products/{productId}/stockAlerts/{stockAlertId}",
        "definition": {
          "entityName": "StockAlert",
          "schema": {
            "$ref": "#/backend/entities/StockAlert"
          },
          "description": "Stores stock alert information for each article. `productId` identifies the article, and `stockAlertId` is the unique identifier for the stock alert.",
          "params": [
            {
              "name": "productId",
              "description": "Unique identifier for the article."
            },
            {
              "name": "stockAlertId",
              "description": "Unique identifier for the stock alert."
            }
          ]
        }
      },
      {
        "path": "/reports/{reportId}",
        "definition": {
          "entityName": "Report",
          "schema": {
            "$ref": "#/backend/entities/Report"
          },
          "description": "Stores report data. `reportId` is the unique identifier for the report.",
          "params": [
            {
              "name": "reportId",
              "description": "Unique identifier for the report."
            }
          ]
        }
      },
      {
        "path": "/clients/{clientId}",
        "definition": {
          "entityName": "Client",
          "schema": {
            "$ref": "#/backend/entities/Client"
          },
          "description": "Stores client information. `clientId` is the unique identifier for the client.",
          "params": [
            {
              "name": "clientId",
              "description": "Unique identifier for the client."
            }
          ]
        }
      },
      {
        "path": "/purchaseOrders/{purchaseOrderId}",
        "definition": {
          "entityName": "PurchaseOrder",
          "schema": {
            "$ref": "#/backend/entities/PurchaseOrder"
          },
          "description": "Stores purchase order information. `purchaseOrderId` is the unique identifier for the purchase order.",
          "params": [
            {
              "name": "purchaseOrderId",
              "description": "Unique identifier for the purchase order."
            }
          ]
        }
      },
      {
        "path": "/purchaseReceipts/{purchaseReceiptId}",
        "definition": {
          "entityName": "PurchaseReceipt",
          "schema": {
            "$ref": "#/backend/entities/PurchaseReceipt"
          },
          "description": "Stores purchase receipt information. `purchaseReceiptId` is the unique identifier for the purchase receipt.",
          "params": [
            {
              "name": "purchaseReceiptId",
              "description": "Unique identifier for the purchase receipt."
            }
          ]
        }
      },
      {
        "path": "/purchaseInvoices/{purchaseInvoiceId}",
        "definition": {
          "entityName": "PurchaseInvoice",
          "schema": {
            "$ref": "#/backend/entities/PurchaseInvoice"
          },
          "description": "Stores purchase invoice information. `purchaseInvoiceId` is the unique identifier for the purchase invoice.",
          "params": [
            {
              "name": "purchaseInvoiceId",
              "description": "Unique identifier for the purchase invoice."
            }
          ]
        }
      }
    ],
    "reasoning": "The Firestore structure is designed to reflect the relationships between Suppliers, Products, StockAlerts, and Reports in the StockPilot application. The design prioritizes simplicity, security, and scalability, focusing on authorization independence.  \n\nSuppliers are stored in the `/suppliers` collection. Products are now a top-level collection `/products` to allow a many-to-many relationship between products and suppliers implicitly through purchase orders. StockAlerts are organized under each product in `/products/{productId}/stockAlerts`. Reports are stored in a top-level `/reports` collection. This structure facilitates simple rules since it avoids hierarchical authorization dependencies (no `get()` calls needed).\n\nAuthorization Independence is achieved through path-based ownership where applicable (e.g. alerts under products). Each product is an independent entity. This avoids the need to fetch parent documents to determine access rights.\n\nThe structure facilitates secure `list` operations by using structural segregation. Each collection (`suppliers`, `products`, `stockAlerts`, `reports`, `clients`, `purchaseOrders`) contains documents with similar access control requirements. For example, only authorized users will be able to list suppliers, and similarly for the other collections."
  }
}
